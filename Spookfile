-- These helpers come built-in but must
-- be required for use.
{
  :until_success
  :command
  :task_filter
  :notifies
} = require 'spookfile_helpers'

fs = require 'fs'
{:notify, :load_spookfile} = _G

log_level "INFO"

-- This notifier is built-in.
notify.add 'terminal_notifier'

-- Add whatever other notifier you like,
-- just make sure it's in the package path.
-- Do note that notifiers are slightly
-- different in 0.7.x from 0.6.x.
pcall notify.add, 'notifier'

-- Filters tasks on whether the mapped
-- file is present (eg. won't run unless it is)
task_list = task_filter fs.is_present

-- Setup some commands, eg. wrap commands
-- that can later be called with a path as
-- input.
lint = command "./bin/howl-lint"
spec = command "./bin/howl-spec"

-- The spec for base, a path without its extension: base_spec.howl if it
-- exists, else base_spec.moon.
spec_for = (base) ->
  howl_spec = "#{base}_spec.howl"
  fs.is_present(howl_spec) and howl_spec or "#{base}_spec.moon"

run_spec = (path, event) ->
  print "\027[1m\027[34m-> \027[22m(#{path}..)\027[0m"
  if event.path\match('%.moon$') or event.path\match('%.howl$')
    notifies path, event,
      task_list(
        spec, path
        lint, event.path
      )
  else -- Lua isn't linted
    notifies path, event, task_list(spec, path)

watch "lib", "spec", ->
  for ext in *{'moon', 'howl'}
    on_changed "_spec%.#{ext}$", (event) ->
      run_spec event.path, event

  for ext in *{'moon', 'howl', 'lua'}
    on_changed "^lib/howl/.+%.#{ext}$", (event) ->
      base = event.path\match "^lib/howl/(.*)%.#{ext}$"
      run_spec spec_for("spec/#{base}"), event

    on_changed "^lib/aullar/.+%.#{ext}$", (event) ->
      base = event.path\match "^lib/aullar/(.*)%.#{ext}$"
      run_spec spec_for("lib/aullar/spec/#{base}"), event

    on_changed "^lib/ljglibs/.+%.#{ext}$", (event) ->
      base = event.path\match "^lib/ljglibs/(.*)%.#{ext}$"
      run_spec spec_for("lib/ljglibs/spec/#{base}"), event

  -- the compiler's parts all feed each other, so any change runs the whole suite
  on_changed "^lib/howlscript/.+%.lua$", (event) ->
    run_spec "lib/howlscript/spec", event

watch "bundles", ->
  for ext in *{'moon', 'howl'}
    on_changed "_spec%.#{ext}$", (event) ->
      run_spec event.path, event

  for ext in *{'moon', 'howl', 'lua'}
    on_changed "%.#{ext}$", (event) ->
      dir, base = event.path\match "^(.+)/(.+)%.#{ext}$"
      unless base\find '_spec'
        run_spec spec_for("#{dir}/spec/#{base}"), event

watch_file 'Spookfile', ->
  on_changed (event) ->
    notify.info "Reloading Spookfile..."
    load_spookfile!
