define = (name, text) ->
  howl.ui.icon.define name,
    font:
      family: 'Symbols Nerd Font'
      size: 'small'
    :text

for name, text in pairs font_awesome_text
  define 'nerd-'..name, text

for name, text in pairs codicon_text
  define 'nerd-cod-'..name, text
