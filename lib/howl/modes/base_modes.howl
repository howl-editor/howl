{:mode} = howl

curly_mode = {
  indentation: {
    more_after: {
      '[[{(]%s*$',
    }

    less_for: {
      '^%s*[]})]',
    }
  }

  code_blocks: {
    multiline: {
      { '{%s*$', '^%s*}', '}'}
      { '%[%s*$', '^%s*%]', ']'}
      { '%(%s*$', '^%s*%)', ')'}
    }
  }

}

return mode.register(name: 'curly_mode', create: -> curly_mode)
