#
# Converts MoonScript files to Howlscript.

. "$(dirname "$0")/_howl_env.sh"

for a in "$@"; do
  case "$a" in
    -h|--help)
      cat <<'EOF'
Usage: howl-convert [-w] [--spec] [--howl] <file.moon>...

Converts MoonScript to Howlscript, following lib/howlscript/CONVERTING.md, and
prints the result. Warnings for what needs a look, and errors compiling the
result, go to stderr. Exits 1 if there were any.

  -w, --write  write <name>.howl next to each file and remove <name>.moon
               (with git rm when it's tracked)
  --spec       convert every file as a busted spec, leaving busted's calls
               without parentheses (the default for files named *_spec.moon)
  --howl       for Howl's own files: copyright years end with this year, and a
               file without a copyright header gets one
  -h, --help   this help

Examples:
  howl-convert lib/aullar/cursor.moon
  howl-convert -w --howl lib/aullar/*.moon lib/aullar/spec/*.moon
EOF
      exit 0
      ;;
  esac
done

exec "$HOWL" --no-profile --run "$ROOT/lib/scripts/moon_to_howl.lua" "$@"
