#! /bin/sh
#
# Copyright 2026 The Howl Developers
# License: MIT (see LICENSE.md at the top-level directory of the distribution)
#
# The whole change loop for a source file, in one command: recompile it if its .bc is
# stale, lint it, and run its spec.
#
# The source-to-spec mapping mirrors the one in Spookfile.

. "$(dirname "$0")/_howl_env.sh"

cd "$ROOT" || exit 1

if [ $# -eq 0 ]; then
  cat <<'EOF'
Usage: howl-check <file.moon|file.howl|file.lua>...

For each file: recompile it if it has a stale .bc, lint it (.moon and .howl only;
a .howl file is only compiled), and run its spec. Stops at the first failing step
and reports which one it was.

  lib/howl/X.<ext>          -> spec/X_spec.<howl|moon>
  lib/aullar/X.<ext>        -> lib/aullar/spec/X_spec.<howl|moon>
  lib/ljglibs/X.<ext>       -> lib/ljglibs/spec/X_spec.<howl|moon>
  lib/howlscript/X.lua      -> lib/howlscript/spec (the whole suite)
  bundles/<b>/<d>/X.<ext>   -> bundles/<b>/<d>/spec/X_spec.<howl|moon>
  *_spec.moon, *_spec.howl  -> itself

where <ext> is moon, howl or lua, and X_spec.howl is used if it exists.
EOF
  exit 1
fi

# Echoes the spec in directory $1 for the source $2, a path without its extension:
# X_spec.howl if it exists, else X_spec.moon.
spec_in() {
  if [ -e "$1/$2_spec.howl" ]; then
    printf '%s\n' "$1/$2_spec.howl"
  else
    printf '%s\n' "$1/$2_spec.moon"
  fi
}

# Echoes the spec path for a source file, or nothing if there is no mapping.
spec_for() {
  case "$1" in
    *_spec.moon|*_spec.howl) printf '%s\n' "$1"; return ;;
    lib/howlscript/*.lua) printf '%s\n' "lib/howlscript/spec"; return ;;
    *.moon|*.howl|*.lua) ;;
    *) return ;;
  esac

  src=${1%.*}
  case "$src" in
    lib/howl/*) spec_in spec "${src#lib/howl/}" ;;
    lib/aullar/*) spec_in lib/aullar/spec "${src#lib/aullar/}" ;;
    lib/ljglibs/*) spec_in lib/ljglibs/spec "${src#lib/ljglibs/}" ;;
    bundles/*) spec_in "$(dirname "$src")/spec" "$(basename "$src")" ;;
  esac
}

status=0

for f in "$@"; do
  # Accept absolute paths and paths relative to the caller's original directory.
  case "$f" in
    "$ROOT"/*) f=${f#"$ROOT"/} ;;
  esac

  if [ ! -e "$f" ]; then
    echo "howl-check: no such file: $f" >&2
    status=1
    continue
  fi

  echo "== $f"

  bc="${f%.*}.bc"
  case "$f" in
    *_spec.moon|*_spec.howl) ;;  # never compiled
    *)
      if [ -e "$bc" ] && [ "$f" -nt "$bc" ]; then
        "$HOWL" --compile "$f" || { echo "howl-check: compile failed" >&2; status=1; continue; }
      fi
      ;;
  esac

  case "$f" in
    *.moon|*.howl)
      "$ROOT/bin/howl-lint" "$f" || { echo "howl-check: lint failed" >&2; status=1; continue; }
      echo "   lint ok"
      ;;
  esac

  spec=$(spec_for "$f")
  if [ -z "$spec" ]; then
    echo "   no spec mapping for $f"
  elif [ ! -e "$spec" ]; then
    echo "   no spec at $spec"
  else
    "$ROOT/bin/howl-spec" "$spec" || { echo "howl-check: specs failed" >&2; status=1; continue; }
  fi
done

exit $status
