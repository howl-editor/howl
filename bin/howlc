#
# Prints the Lua generated for Howlscript sources, snippets or stdin.

. "$(dirname "$0")/_howl_env.sh"

for a in "$@"; do
  case "$a" in
    -h|--help)
      cat <<'EOF'
Usage: howlc [-e <code>] [<file>|-]...

Prints the Lua that each Howlscript input compiles to. With no arguments, reads
stdin. Each statement of the Lua starts on the line it starts on in the input.
Exits 1 with the error if an input doesn't compile.

  -e, --eval <code>  compile <code> given on the command line
  -                  compile stdin
  -h, --help         this help

Examples:
  howlc lib/howlscript/spec/fixtures/property_object.howl
  howlc -e 'f = (a) -> a + 1'
  echo 'x = 1' | howlc
EOF
      exit 0
      ;;
  esac
done

exec "$HOWL" --no-profile --run "$ROOT/lib/scripts/howlscript_to_lua.moon" "$@"
